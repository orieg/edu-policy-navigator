// src/pages/rag-test.astro
// No server-side processing needed for this basic test page yet.
import fs from 'fs';
import path from 'path';

// --- 1. Server-Side Logic (Astro Frontmatter) ---

// --- 1.1. Access Pre-computed Data ---
let clusterCentroidsData = [];
let clusterContextData = {}; // Combined context from manifest and keywords
// let staticRuleQueryEmbedding = null; // Placeholder

const baseEmbeddingsPath = path.join(process.cwd(), 'public', 'embeddings', 'school_districts');

try {
    // Load Cluster Centroids
    const centroidsPath = path.join(baseEmbeddingsPath, 'centroids.json');
    if (fs.existsSync(centroidsPath)) {
        const centroidsJson = fs.readFileSync(centroidsPath, 'utf-8');
        // The plan mentions `vector` but file has `centroid`. Renaming here for consistency with plan.
        clusterCentroidsData = JSON.parse(centroidsJson).map(c => ({
            clusterId: c.clusterId,
            vector: c.centroid 
        }));
        console.log(`Successfully loaded ${clusterCentroidsData.length} cluster centroids.`);
    } else {
        console.error(`Error: centroids.json not found at ${centroidsPath}`);
    }

    // Load Cluster Contextual Data (from manifest.json for countyName)
    const manifestPath = path.join(baseEmbeddingsPath, 'manifest.json');
    const manifestContext = {};
    if (fs.existsSync(manifestPath)) {
        const manifestJson = fs.readFileSync(manifestPath, 'utf-8');
        const manifestData = JSON.parse(manifestJson);
        if (manifestData.clusters && Array.isArray(manifestData.clusters)) {
            manifestData.clusters.forEach(cluster => {
                if (cluster.clusterId !== undefined && cluster.countyName) {
                    manifestContext[cluster.clusterId] = { countyName: cluster.countyName };
                }
            });
        }
        console.log(`Successfully processed manifest.json for county names.`);
    } else {
        console.warn(`Warning: manifest.json not found at ${manifestPath}. County context will be unavailable.`);
    }

    // Load Cluster Contextual Data (from cluster_keywords.json for keywords)
    const keywordsPath = path.join(baseEmbeddingsPath, 'cluster_keywords.json');
    const keywordsContext = {};
    if (fs.existsSync(keywordsPath)) {
        const keywordsJson = fs.readFileSync(keywordsPath, 'utf-8');
        const keywordsData = JSON.parse(keywordsJson);
        if (Array.isArray(keywordsData)) {
            keywordsData.forEach(item => {
                if (item.clusterId !== undefined && item.keywords) {
                    // Store keywords as a comma-separated string of all keywords
                    keywordsContext[item.clusterId] = { keywords: item.keywords.join(', ') }; 
                }
            });
        }
        console.log(`Successfully processed cluster_keywords.json for keywords.`);
    } else {
        console.warn(`Warning: cluster_keywords.json not found at ${keywordsPath}. Keyword context will be unavailable.`);
    }
    
    // Combine context data: Start with manifest (county names), then add/override with keywords
    // Ensure that if a clusterId exists in one, it's initialized in clusterContextData before merging
    const allContextIds = new Set([...Object.keys(manifestContext), ...Object.keys(keywordsContext)]);
    allContextIds.forEach(id => {
        clusterContextData[id] = {
            ...(manifestContext[id] || {}),
            ...(keywordsContext[id] || {}),
        };
    });

    // Note: Static Rule-Based Query Embedding is not loaded as the file was not found.
    // If 'public/embeddings/static_rule_query_embedding.json' becomes available, logic to load it would go here.
    // For now, staticRuleQueryEmbedding remains null or undefined.

} catch (error) {
    console.error("Error loading pre-computed data in Astro frontmatter:", error);
    // Optionally, pass error status to client if needed
}

// --- 1.2. Pass Data to Client ---
// This part will be handled by modifying the <script define:vars> tag later.
// For now, these variables are prepared: clusterCentroidsData, clusterContextData

