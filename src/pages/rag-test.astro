                    >
                    <div id="similarityResultsArea" style="margin-top: 15px;">
                        <!-- Similarity results will be populated here by JavaScript -->
                    </div>
                </fieldset>
            </details>
            <!-- End of New Section -->

            <hr style="margin: 30px 0;" />

            <!-- NEW: Dedicated BM25 Test Section -->
            <fieldset>
                <legend>Dedicated BM25 Full-Text Search Test</legend>
                <p>Test the BM25 retrieval component directly. Uses parameters from the "BM25 Parameters" and "Top N Results" inputs above (from the main pipeline controls).</p>
                <button id="testBm25OnlyBtn" disabled>Test BM25 Retrieval Only</button>
                <h4>BM25 Test Results:</h4>
                <div id="dedicatedBm25TestResultsArea" class="output-area" style="margin-top: 10px;">
                    <!-- Dedicated BM25 test results will appear here -->
                </div>
            </fieldset>
            <!-- END: Dedicated BM25 Test Section -->

            <hr style="margin: 30px 0;" />

            <!-- REMOVE REDUNDANT Hybrid Search PoC Elements from here -->
            <!-- These were moved up -->
            <!-- END: Hybrid Search PoC Elements -->

            <div id="responseAreaContainer" class="intermediate-output" style="display: none;">
                <h4>Raw LLM Response:</h4>
                <div id="responseArea"></div>
            </div>

            <div id="similarityResultsArea" class="intermediate-output" style="display: none;">
                <h4>Embedding Similarity Validation:</h4>
                <table>
                    <thead>
                        <tr>
                            <th>Document Snippet</th>
                            <th>WebLLM Score</th>
                            <th>In-Browser Transformers Score</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Rows will be added here by JavaScript -->
                    </tbody>
                </table>
            </div>

            <!-- Container for the new RAG similarity table -->
            <div id="ragSimilarityTableContainer" class="intermediate-output" style="display: none;">
                 <div style="margin-bottom: 10px;">
                    <label for="ragTableRowFilterSelect">Show Rows:</label>
                    <select id="ragTableRowFilterSelect" name="ragTableRowFilterSelect" title="Filter number of rows shown in the table below">
                        <option value="all" selected>Show All</option>
                        <option value="5">Show Top 5</option>
                        <option value="10">Show Top 10</option>
                    </select>
                 </div>
                 <h4>RAG Query-Cluster Similarity Analysis:</h4>
                 <!-- Table will be injected here by JavaScript -->
            </div>

            <form id="queryForm" style="margin-top: 10px;">
                <div style="margin-bottom: 10px;">
                    <label for="ragTableSimilarityMetricSelect">Similarity/Distance Metric for Table:</label>
                    <select id="ragTableSimilarityMetricSelect" name="ragTableSimilarityMetricSelect" title="Metric for RAG table calculations">
                        <option value="cosine" selected>Cosine Similarity</option>
                        <option value="dot_product">Dot Product</option>
                        <option value="manhattan">Manhattan Distance</option>
                        <option value="euclidean">Euclidean Distance</option>
                    </select>
                </div>
                <!-- This form will now have its own submit button for the RAG table -->
                <button type="submit" id="generateRagTableBtn" style="margin-right: 10px;">Show Query/Cluster Similarity Analysis</button>
                <button type="button" id="clearRagTableBtn">Clear Similarity Table</button>
            </form>

        </div>

        <!-- Astro will handle the .ts import and compilation -->
        <script type="module" src="/src/rag-testing/rag_test_main.ts"></script>

        <script define:vars={{ clusterCentroidsData, clusterContextData }}>
            // --- Client-Side Logic for RAG Similarity Table ---
            const statusLabel = document.getElementById('statusLabel');
            // const similarityTableBody = similarityResultsArea.querySelector('tbody'); // Belongs to a different table

            const ragSimilarityTableContainer = document.getElementById('ragSimilarityTableContainer');
            let pipeline; // For Transformers.js feature extraction

            // --- Helper function to escape HTML --- 
            function escapeHTML(str) {
                if (typeof str !== 'string') return '';
                return str.replace(/[&<>'"`/]/g, function (match) {
                    const escape = {
                        '&': '&amp;',
                        '<': '&lt;',
                        '>': '&gt;',
                        '"': '&quot;',
                        "'": '&#39;', // HTML entity for single quote
                        '/': '&#x2F;', // To prevent closing HTML tags
                        '`': '&#96;'  // HTML entity for backtick
                    };
                    return escape[match];
                });
            }

            // --- 2.2. Helper Functions (as per plan) ---
            function cosineSimilarity(vecA, vecB) {
                if (!vecA || !vecB || vecA.length === 0 || vecA.length !== vecB.length) {
                    console.warn("cosineSimilarity: Invalid input vectors", vecA, vecB);
                    return 0;
                }
                let dotProduct = 0;
                let normA = 0;
                let normB = 0;
                for (let i = 0; i < vecA.length; i++) {
                    dotProduct += vecA[i] * vecB[i];
                    normA += vecA[i] * vecA[i];
                    normB += vecB[i] * vecB[i];
                }
                if (normA === 0 || normB === 0) {
                    return 0; 
                }
                return dotProduct / (Math.sqrt(normA) * Math.sqrt(normB));
            }

            function averageEmbeddings(vecA, vecB) {
                if (!vecA || !vecB || vecA.length === 0 || vecA.length !== vecB.length) {
                    console.warn("averageEmbeddings: Invalid input vectors for averaging", vecA, vecB);
                    return [];
                }
                const result = new Array(vecA.length);
                for (let i = 0; i < vecA.length; i++) {
                    result[i] = (vecA[i] + vecB[i]) / 2;
                }
                return result;
            }

            function dotProduct(vecA, vecB) {
                if (!vecA || !vecB || vecA.length === 0 || vecA.length !== vecB.length) {
                    console.warn("dotProduct: Invalid input vectors", vecA, vecB);
                    return 0;
                }
                let product = 0;
                for (let i = 0; i < vecA.length; i++) {
                    product += vecA[i] * vecB[i];
                }
                return product;
            }

            function manhattanDistance(vecA, vecB) {
                if (!vecA || !vecB || vecA.length === 0 || vecA.length !== vecB.length) {
                    console.warn("manhattanDistance: Invalid input vectors", vecA, vecB);
                    return Infinity; // Or some other indicator of error/max distance
                }
                let distance = 0;
                for (let i = 0; i < vecA.length; i++) {
                    distance += Math.abs(vecA[i] - vecB[i]);
                }
                return distance;
            }

            function euclideanDistance(vecA, vecB) {
                if (!vecA || !vecB || vecA.length === 0 || vecA.length !== vecB.length) {
                    console.warn("euclideanDistance: Invalid input vectors", vecA, vecB);
                    return Infinity; // Or some other indicator of error/max distance
                }
                let sumOfSquares = 0;
                for (let i = 0; i < vecA.length; i++) {
                    sumOfSquares += Math.pow(vecA[i] - vecB[i], 2);
                }
                return Math.sqrt(sumOfSquares);
            }

            // Log passed data for Milestone 1 Verification
            console.log("Milestone 1 Verification: Data passed from server (for RAG Table):", {
                clusterCentroidsData,
                clusterContextData
            });

            document.addEventListener('DOMContentLoaded', async () => {
                const mainQueryInput = document.getElementById('queryInput');
                const queryForm = document.getElementById('queryForm');
                
                const generateTableButton = document.getElementById('generateRagTableBtn');
                const clearTableButton = document.getElementById('clearRagTableBtn');
                    
                const responseArea = document.getElementById('responseArea'); 
                const responseAreaContainer = document.getElementById('responseAreaContainer');

                const progressBarContainer = document.getElementById('progressBarContainer');
                const progressBar = document.getElementById('progressBar');

                const T = window.transformers;

                if (!T) {
                    console.error("Transformers.js (window.transformers) is not available for RAG Table. Ensure it's loaded.");
                    if(statusLabel) statusLabel.textContent = "Critical Error: Transformers.js library not found for RAG Table.";
                    if(generateTableButton) generateTableButton.disabled = true;
                    return;
                }
                    
                function updateStatus(message, isLoading = false) {
                    if (statusLabel) statusLabel.textContent = message;
                    if (progressBarContainer && generateTableButton) {
                        progressBarContainer.style.display = isLoading ? 'block' : 'none';
                        generateTableButton.disabled = isLoading;
                    }
                }

                function updateProgressBar(percentage) {
                    if (progressBar) {
                        progressBar.style.width = percentage + '%';
                        progressBar.textContent = percentage + '%';
                    }
                }

                if (queryForm && mainQueryInput && ragSimilarityTableContainer && generateTableButton) {
                    queryForm.addEventListener('submit', async function (event) {
                        event.preventDefault();
                        const userQueryString = mainQueryInput.value.trim();

                        if (!userQueryString) {
                            alert('Please enter a query in the main query input field to generate the RAG similarity table.');
                            return;
                        }

                        const selectedMetric = document.getElementById('ragTableSimilarityMetricSelect').value;
                        const isDistanceMetric = selectedMetric === 'manhattan' || selectedMetric === 'euclidean';
                        
                        let metricFunctionName = "Cosine Sim";
                        if (selectedMetric === 'dot_product') metricFunctionName = "Dot Product";
                        else if (selectedMetric === 'manhattan') metricFunctionName = "Manhattan Dist";
                        else if (selectedMetric === 'euclidean') metricFunctionName = "Euclidean Dist";

                        updateStatus('Processing for RAG Similarity Table...', true);
                        updateProgressBar(0);
                        
                        if(responseAreaContainer) responseAreaContainer.style.display = 'block';
                        if(responseArea) responseArea.textContent = ''; // Clear main response area for this action's mock message
                        
                        ragSimilarityTableContainer.innerHTML = '';
                        ragSimilarityTableContainer.style.display = 'none';

                        try {
                            if (!pipeline) {
                                updateStatus('Loading embedding model (Snowflake/snowflake-arctic-embed-xs for RAG Table)...', true);
                                updateProgressBar(5);
                                pipeline = await T.pipeline('feature-extraction', 'Snowflake/snowflake-arctic-embed-xs', {
                                    progress_callback: (progress) => {
                                        updateProgressBar(5 + Math.round(progress.progress * 0.15)); 
                                    }
                                });
                                updateStatus('Embedding model loaded for RAG Table. Generating embeddings...', true);
                            }
                            updateProgressBar(20);

                            // Get the original user query string
                            const originalUserQueryString = mainQueryInput.value.trim();
                            if (!originalUserQueryString) {
                                updateStatus('Original user query is empty. Cannot generate table.', false);
                                ragSimilarityTableContainer.innerHTML = '<p style="color:orange;">Please enter a query in the main text area above.</p>';
                                return;
                            }

                            // Attempt to get the rule-based query from the main script, fallback to original
                            let ruleBasedQueryString = originalUserQueryString; // Default to original
                            let ruleBasedQueryNote = "(using original query as fallback for rule-based query)";
                            if (window.currentRephrasedQueryForTable && typeof window.currentRephrasedQueryForTable === 'string') {
                                ruleBasedQueryString = window.currentRephrasedQueryForTable;
                                ruleBasedQueryNote = "(using rule-based rephrased query from step-by-step panel)";
                            } else {
                                console.warn("RAG Table: window.currentRephrasedQueryForTable not available or not a string. Using original query for rule-based part.");
                            }

                            updateStatus('Generating embedding for original query...', true);
                            const originalUserQueryEmbeddingTensor = await pipeline(originalUserQueryString, { pooling: 'mean', normalize: true });
                            const originalUserQueryEmbedding = Array.from(originalUserQueryEmbeddingTensor.data);
                            updateProgressBar(40);

                            const ruleBasedQueryEmbeddingTensor = await pipeline(ruleBasedQueryString, { pooling: 'mean', normalize: true });
                            const ruleBasedQueryEmbedding = Array.from(ruleBasedQueryEmbeddingTensor.data);
                            updateProgressBar(60);

                            function calculateMetric(vecA, vecB, metric) {
                                switch (metric) {
                                    case 'dot_product':
                                        return dotProduct(vecA, vecB);
                                    case 'manhattan':
                                        return manhattanDistance(vecA, vecB);
                                    case 'euclidean':
                                        return euclideanDistance(vecA, vecB);
                                    case 'cosine':
                                    default:
                                        return cosineSimilarity(vecA, vecB);
                                }
                            }
                            
                            updateStatus('Preparing to display all clusters for RAG Table...', true);
                            if (!clusterCentroidsData || clusterCentroidsData.length === 0) {
                                console.warn("RAG Table: No cluster centroids data available to display.");
                            }
                            const relevantCentroidsToDisplay = clusterCentroidsData; // Use all clusters
                            console.log(`RAG Table: Will display all ${relevantCentroidsToDisplay ? relevantCentroidsToDisplay.length : 0} clusters.`);
                            updateProgressBar(65);
                            
                            updateStatus('Calculating similarities and building RAG Table...', true);

                            ragSimilarityTableContainer.innerHTML = '';

                            const originalQueryDisplay = document.createElement('p');
                            originalQueryDisplay.innerHTML = `<strong>Original User Query:</strong> ${escapeHTML(originalUserQueryString)}`;
                            ragSimilarityTableContainer.appendChild(originalQueryDisplay);

                            const ruleBasedQueryDisplay = document.createElement('p');
                            ruleBasedQueryDisplay.innerHTML = `<strong>Rule-Based Query:</strong> ${escapeHTML(ruleBasedQueryString)} <em>${escapeHTML(ruleBasedQueryNote)}</em>`;
                            ragSimilarityTableContainer.appendChild(ruleBasedQueryDisplay);

                            const table = document.createElement('table');
                            const thead = document.createElement('thead');
                            const tbody = document.createElement('tbody');

                            thead.innerHTML = `<tr>
                                <th>Cluster ID</th>
                                <th>Context (Keywords / County)</th>
                                <th>${metricFunctionName} (Original Query &harr; Centroid)</th>
                                <th>${metricFunctionName} (Rule-Based Query &harr; Centroid)</th>
                                <th>${metricFunctionName} (Average Query &harr; Centroid)</th>
                            </tr>`;
                            table.appendChild(thead);
                            table.appendChild(tbody);

                            let rowsProcessed = 0;
                            for (const cluster of relevantCentroidsToDisplay) {
                                const clusterCentroidVector = cluster.vector;
                                const clusterId = cluster.clusterId;
                                let contextualInfoString = "N/A";
                                if (clusterContextData && clusterContextData[clusterId]) {
                                    const context = clusterContextData[clusterId];
                                    const parts = [];
                                    if (context.countyName) parts.push(`County: ${context.countyName}`);
                                    if (context.keywords) parts.push(`Keywords: ${context.keywords}`);
                                    contextualInfoString = parts.join('; ') || "N/A";
                                }
                                const avgQueryEmbedding = averageEmbeddings(originalUserQueryEmbedding, ruleBasedQueryEmbedding);
                                
                                const sim_original_to_centroid = calculateMetric(originalUserQueryEmbedding, clusterCentroidVector, selectedMetric);
                                const sim_rule_to_centroid = calculateMetric(ruleBasedQueryEmbedding, clusterCentroidVector, selectedMetric);
                                const sim_average_to_centroid = calculateMetric(avgQueryEmbedding, clusterCentroidVector, selectedMetric);
                                const row = tbody.insertRow();
                                row.insertCell().textContent = clusterId;
                                row.insertCell().textContent = contextualInfoString;
                                row.insertCell().textContent = sim_original_to_centroid.toFixed(4);
                                row.insertCell().textContent = sim_rule_to_centroid.toFixed(4);
                                row.insertCell().textContent = sim_average_to_centroid.toFixed(4);
                                rowsProcessed++;
                                updateProgressBar(65 + Math.round((rowsProcessed / Math.max(1, relevantCentroidsToDisplay.length)) * 30));
                            }
                            
                            const mainSectionTitleText = ragSimilarityTableContainer.dataset.initialTitle || 'RAG Query-Cluster Similarity Analysis:';
                            const titleElement = document.createElement('h4');
                            titleElement.textContent = mainSectionTitleText;
                            ragSimilarityTableContainer.insertBefore(titleElement, originalQueryDisplay);

                            if (relevantCentroidsToDisplay.length === 0) {
                                const noDataTableMessage = document.createElement('p');
                                noDataTableMessage.textContent = 'No cluster data available to display.';
                                ragSimilarityTableContainer.appendChild(noDataTableMessage);
                            }

                            ragSimilarityTableContainer.appendChild(table);
                            ragSimilarityTableContainer.style.display = 'block';
                            makeTableSortable(table); // Make the newly created table sortable
                            
                            // Apply initial visibility filter
                            const initialFilterValue = document.getElementById('ragTableRowFilterSelect')?.value || 'all';
                            applyRowVisibilityFilter(table.querySelector('tbody'), initialFilterValue);

                            if(responseArea) responseArea.textContent = `(Mock LLM Response for RAG Table query: "${escapeHTML(originalUserQueryString)}")\n\nThe table above shows similarity scores. The main RAG pipeline response would appear here if triggered by its own controls.`;
                            
                            updateStatus('RAG Similarity Table processing complete.', false);
                            updateProgressBar(100);
                            console.log("RAG Table: Successfully generated and displayed.");

                        } catch (error) {
                            console.error('Error during RAG Table generation process:', error);
                            if(responseArea) responseArea.textContent = 'Error generating RAG Table: ' + error.message;
                            updateStatus('Error with RAG Table. Check console.', false);
                        }
                    });
                } else {
                    console.warn("RAG Table: Query form, main query input, table container, or generate button not found. Init failed.");
                    if(statusLabel) statusLabel.textContent = "Warning: Page elements missing for RAG table feature.";
                }
                
                if (clearTableButton && ragSimilarityTableContainer) {
                    clearTableButton.addEventListener('click', () => {
                        ragSimilarityTableContainer.innerHTML = ''; 
                        const initialTitleText = ragSimilarityTableContainer.dataset.initialTitle || 'RAG Query-Cluster Similarity Analysis:';
                        const title = document.createElement('h4');
                        title.textContent = initialTitleText;
                        ragSimilarityTableContainer.appendChild(title);
                        ragSimilarityTableContainer.style.display = 'none';
                        
                        if(statusLabel) statusLabel.textContent = 'Ready. Enter a query for RAG Table or main pipeline.';
                        updateProgressBar(0);
                        if(generateTableButton) generateTableButton.disabled = false;
                    });
                }

                if (statusLabel) {
                    if (clusterCentroidsData && clusterCentroidsData.length > 0) {
                        updateStatus('Ready. Enter a query for RAG Table or use main pipeline controls.');
                    } else {
                        updateStatus('Warning: Cluster centroids data not loaded for RAG Table. Feature may be limited.', false);
                        console.warn("RAG Table: Cluster centroids data empty/not loaded. Feature may not function correctly.");
                    }
                }
                if (ragSimilarityTableContainer) {
                    const initialTitleElement = ragSimilarityTableContainer.querySelector('h4');
                    if (initialTitleElement) {
                        ragSimilarityTableContainer.dataset.initialTitle = initialTitleElement.textContent;
                    }
                }

                // Add event listener for the new row filter select
                const rowFilterSelect = document.getElementById('ragTableRowFilterSelect');
                if (rowFilterSelect && ragSimilarityTableContainer) {
                    rowFilterSelect.addEventListener('change', (event) => {
                        const table = ragSimilarityTableContainer.querySelector('table');
                        if (table && table.querySelector('tbody')) {
                            applyRowVisibilityFilter(table.querySelector('tbody'), event.target.value);
                        }
                    });
                }
            });

            // --- NEW: Function to make table sortable ---
            function makeTableSortable(table) {
                const headers = table.querySelectorAll('th');
                const tbody = table.querySelector('tbody');
                let sortDirections = Array(headers.length).fill(null); // null, 'asc', or 'desc'

                // Determine if the current metric is a distance metric (lower is better)
                // This needs to be known at the time of sorting. We can pass it or re-check.
                // For simplicity, we'll check the header text for "Dist"
                
                headers.forEach((header, index) => {
                    header.style.cursor = 'pointer';
                    header.addEventListener('click', () => {
                        const rows = Array.from(tbody.querySelectorAll('tr'));
                        const currentDirection = sortDirections[index];
                        
                        // For distance metrics, the "natural" ascending sort means smaller values are first.
                        // For similarity metrics, "natural" ascending sort means smaller values are first (less similar).
                        // The visual toggle should be consistent: ▲ for ascending, ▼ for descending by value.
                        let newDirection = currentDirection === 'asc' ? 'desc' : 'asc';
                        
                        const headerText = header.textContent || "";
                        const isDistanceColumn = headerText.includes("Dist");

                        headers.forEach((h, i) => {
                            if (i !== index) {
                                h.textContent = h.textContent.replace(/ [▲▼]$/, ''); 
                                sortDirections[i] = null;
                            }
                        });

                        sortDirections[index] = newDirection;
                        // Update indicator based on newDirection value (asc/desc)
                        header.textContent = header.textContent.replace(/ [▲▼]$/, '') + (newDirection === 'asc' ? ' ▲' : ' ▼');

                        const isNumericColumn = (index === 0 || index >= 2); // Cluster ID and metric columns

                        rows.sort((rowA, rowB) => {
                            const cellA_text = rowA.cells[index].textContent.trim();
                            const cellB_text = rowB.cells[index].textContent.trim();

                            if (isNumericColumn) {
                                const numA = parseFloat(cellA_text);
                                const numB = parseFloat(cellB_text);

                                let comparison = 0;
                                if (numA < numB) comparison = -1;
                                if (numA > numB) comparison = 1;

                                // If it's a distance column, ascending sort (smallest first) is "better"
                                // If it's a similarity column, ascending sort (smallest first) is "worse"
                                // The 'asc'/'desc' in newDirection refers to value order.
                                // So, if newDirection is 'asc', we want smaller values first.
                                // If newDirection is 'desc', we want larger values first.
                                // This logic is fine as is.
                                return newDirection === 'asc' ? comparison : -comparison;

                            } else { // Text column (Context)
                                return newDirection === 'asc' 
                                    ? cellA_text.localeCompare(cellB_text, undefined, { sensitivity: 'base' }) 
                                    : cellB_text.localeCompare(cellA_text, undefined, { sensitivity: 'base' });
                            }
                        });

                        tbody.innerHTML = ''; 
                        rows.forEach(row => tbody.appendChild(row));
                    });
                });
            }
            // --- END: Function to make table sortable ---

            // --- NEW: Function to apply row visibility filter ---
            function applyRowVisibilityFilter(tableBody, filterValue) {
                if (!tableBody) return;
                const rows = Array.from(tableBody.querySelectorAll('tr'));
                let limit = rows.length;
                if (filterValue === '5') {
                    limit = 5;
                } else if (filterValue === '10') {
                    limit = 10;
                }

                rows.forEach((row, index) => {
                    if (index < limit) {
                        row.style.display = ''; // Show row
                    } else {
                        row.style.display = 'none'; // Hide row
                    }
                });
            }
            // --- END: Function to apply row visibility filter ---
        </script>
    </body>
</html>
